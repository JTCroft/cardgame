{% extends "base.html.jinja2" %}
{% block title %}{% if review_entry_id %}Reviewing room {{ code }}{% else %}Room {{ code }}{% endif %} - Cross Kings{% endblock %}
{% block nav_extra %}
<span class="room-code">{{ code }}</span>
{% endblock %}
{% block content %}
<div id="game-state">
    <p>Loading...</p>
</div>
{% endblock %}

{% block scripts %}
<script>
    ROOM_KEY = {{ code | tojson }};
    REVIEW_ENTRY_ID = {{ (review_entry_id or none) | tojson }};

    // Claiming/leaving a seat is a room-only concept - a solo game's seats
    // are always both already filled (you and the computer), so
    // play.html.jinja2 never needs these.
    function claimSeat(seat) {
        requireNameThen("claim_seat", { code: ROOM_KEY, seat: seat });
    }
    function leaveSeat() {
        socket.emit("vacate_seat", withIdentity({ code: ROOM_KEY }));
    }
</script>
{% endblock %}
