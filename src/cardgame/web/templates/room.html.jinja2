{% extends "base.html.jinja2" %}
{% block title %}Room {{ code }} - Cross Kings{% endblock %}
{% block content %}
<header class="top">
    <span>Room</span>
    <span class="room-code">{{ code }}</span>
</header>

<p>Share this page's link with your opponent so they can join room <strong>{{ code }}</strong>.
<a href="{{ url_for('rooms_view') }}">Browse other rooms &rarr;</a></p>

<div id="game-state">
    {% include "_game_state.html.jinja2" %}
</div>

<p><a href="{{ url_for('index') }}">&larr; Back to home</a></p>
{% endblock %}

{% block scripts %}
<script>
    const ROOM_CODE = {{ code | tojson }};

    socket.on("connect", () => {
        socket.emit("join", { code: ROOM_CODE });
    });

    socket.on("state", (payload) => {
        document.getElementById("game-state").innerHTML = payload.html;
    });

    socket.on("disconnect", () => {
        const el = document.getElementById("flash-container");
        el.innerHTML = "<div class=\"flash\">Connection lost, trying to reconnect...</div>";
    });

    function sendMove(row, col) {
        socket.emit("move", { code: ROOM_CODE, row: row, col: col });
    }

    function requestRematch() {
        socket.emit("request_rematch", { code: ROOM_CODE });
    }

    function respondRematch(accept) {
        socket.emit("respond_rematch", { code: ROOM_CODE, accept: accept });
    }

    function historyStep(delta) {
        socket.emit("history_step", { code: ROOM_CODE, delta: delta });
    }

    function historyGoto(index) {
        socket.emit("history_goto", { code: ROOM_CODE, index: index });
    }

    function openGameOverModal() {
        const el = document.getElementById("game-over-modal");
        if (el) el.classList.add("open");
    }

    function closeGameOverModal() {
        const el = document.getElementById("game-over-modal");
        if (el) el.classList.remove("open");
    }

    function claimSeat(seat) {
        requireNameThen("claim_seat", { code: ROOM_CODE, seat: seat });
    }

    function leaveSeat() {
        socket.emit("vacate_seat", { code: ROOM_CODE });
    }

    // Mobile bottom-tab hand drawers: tapping a tab slides that player's
    // hand up from the bottom; tapping it again (or the other tab) closes it.
    function toggleDrawer(seat) {
        const el = document.getElementById("hand-slot-" + seat);
        const other = document.getElementById("hand-slot-" + (seat === 1 ? 2 : 1));
        if (!el) return;
        const isOpen = el.classList.contains("open");
        if (other) other.classList.remove("open");
        el.classList.toggle("open", !isOpen);
    }
</script>
{% endblock %}
