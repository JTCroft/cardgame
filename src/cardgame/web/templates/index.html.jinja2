{% extends "base.html.jinja2" %}
{% block title %}Cross Kings{% endblock %}
{% block content %}
<div class="home">
    <header class="home-hero">
        <h1 class="visually-hidden">Cross Kings</h1>
        <img class="home-hero-cards" src="{{ url_for('static', filename='logo.svg') }}" alt="Cross Kings">
        <p class="home-tagline">A two-player card game. Collect cards from the
        grid, score runs and sets, and outscore your opponent.</p>
        <p><a href="{{ url_for('how_to_play') }}">Learn how to play &rarr;</a></p>
    </header>

    <div class="home-options">
        <section class="home-card">
            <h2>Play the computer</h2>
            <p>Jump straight into a solo game against the computer opponent.</p>
            <a class="button home-primary" href="{{ url_for('play') }}">Play the computer</a>
        </section>

        <section class="home-card">
            <h2>Play a friend</h2>
            <p>Create a room and share the link, or enter a code to join one.</p>
            <form method="post" action="{{ url_for('create_room') }}">
                <button type="submit" class="home-primary">Create a new room</button>
            </form>
            <form class="home-join" method="post" action="{{ url_for('join_room_form') }}">
                <input type="text" class="room-code-input" name="code" maxlength="4" placeholder="ABCD" required pattern="[A-Za-z]{4}">
                <button type="submit">Join</button>
            </form>
            <p><a href="{{ url_for('rooms_view') }}">Browse the room list &rarr;</a></p>
        </section>
    </div>
</div>
{% endblock %}
