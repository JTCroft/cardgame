{% extends "base.html.jinja2" %}
{% block title %}Cross Kings{% endblock %}
{% block content %}
<h1>Cross Kings</h1>
<p>A 2 player card game. Start a new room and share the link with an opponent,
or join a room someone shared with you.</p>

<form method="post" action="{{ url_for('create_room') }}">
    <button type="submit">Create a new room</button>
</form>

<h2>Play against the computer</h2>
<p>Play solo against a basic computer opponent.</p>
<a href="{{ url_for('play') }}"><button type="button">Play vs computer</button></a>

<h2>Join a room</h2>
<form method="post" action="{{ url_for('join_room_form') }}">
    <input type="text" class="room-code-input" name="code" maxlength="4" placeholder="ABCD" required pattern="[A-Za-z]{4}">
    <button type="submit">Join</button>
</form>

<p><a href="{{ url_for('rooms_view') }}">Browse the room list &rarr;</a></p>
{% endblock %}
