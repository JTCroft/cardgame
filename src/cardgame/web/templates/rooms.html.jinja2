{% extends "base.html.jinja2" %}
{% block title %}Room List - Cross Kings{% endblock %}
{% block content %}
<h1>Room List</h1>
<p><a href="{{ url_for('index') }}">&larr; Back to home</a></p>

<div id="lobby-list">
    {% include "_lobby_state.html.jinja2" %}
</div>
{% endblock %}

{% block scripts %}
<script>
    socket.on("connect", () => {
        socket.emit("join_lobby");
    });
    socket.on("lobby_state", (payload) => {
        document.getElementById("lobby-list").innerHTML = payload.html;
    });
</script>
{% endblock %}
