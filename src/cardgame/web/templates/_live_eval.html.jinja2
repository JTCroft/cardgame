{# The live-eval panel: a snapshot from cardgame.search_alt's anytime
   search of the *current* position, re-pushed over the "live_eval" socket
   event as the search refines. Lives outside #game-state so board
   re-renders don't wipe it between pushes. Non-best rows' ranges are
   window-relative, like any alpha-beta engine's move scores: a move cut
   off early shows "no better than" information, not its exact value. #}
<div class="move-analysis live-eval-panel">
    <h3>Live evaluation
        <span class="analysis-sub">{{ mover_name }} to move &mdash; {{ status }}</span>
    </h3>
    <div class="analysis-table-wrap">
        <table class="analysis-table">
            <thead>
                <tr>
                    <th>Take</th>
                    <th title="Average win chance (draws half) over the outcomes resolved so far">win</th>
                    <th title="Average final score margin over the outcomes resolved so far">avg pts</th>
                    <th title="Bounds on the final score margin; unexplored outcomes count at +/-26">pts range</th>
                    <th title="Share of this move's possible outcomes resolved exactly">explored</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for move in snapshot.moves %}
                <tr class="{% if not move.alive %}analysis-out{% endif %}">
                    <td>
                        {%- if move.card == "??" -%}
                            Face-down (row {{ move.marker[0] + 1 }}, col {{ move.marker[1] + 1 }})
                        {%- else -%}
                            <span class="cardtext{% if "♥" in move.card or "♦" in move.card %} red{% endif %}">{{ move.card }}</span>
                        {%- endif -%}
                    </td>
                    <td class="num">{% if move.mean_win is not none %}{{ "%.0f"|format(100 * move.mean_win) }}%{% else %}&ndash;{% endif %}</td>
                    <td class="num">{% if move.mean_score is not none %}{{ "%+.2f"|format(move.mean_score) }}{% else %}&ndash;{% endif %}</td>
                    <td class="num">{{ "%+.1f"|format(move.score_bounds[0]) }}&hellip;{{ "%+.1f"|format(move.score_bounds[1]) }}</td>
                    <td class="num">{{ "%.0f"|format(100 * move.explored) }}%</td>
                    <td class="badges">
                        {%- if move.marker == snapshot.best %}<span class="badge badge-best">best</span>{% endif -%}
                        {%- if not move.alive %}<span class="badge badge-out">out</span>{% endif -%}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
