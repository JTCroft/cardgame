{% import "components.html.jinja2" as macros %}

{% macro rematch_controls() %}
    {% if is_spectator %}
        {% if rematch_pending %}
            <p>Waiting for the players to decide on a rematch...</p>
        {% endif %}
    {% elif rematch_pending %}
        {% if rematch_requested_by_me %}
            <p>Waiting for {{ ((p2_name if my_seat == 1 else p1_name)) or "the other player" }} to respond...</p>
        {% else %}
            <p>{{ rematch_requested_by_name or "The other player" }} wants a rematch!</p>
            <button type="button" onclick="respondRematch(true)">Accept</button>
            <button type="button" onclick="respondRematch(false)">Decline</button>
        {% endif %}
    {% else %}
        <button type="button" onclick="requestRematch()">Request rematch</button>
    {% endif %}
{% endmacro %}

<div class="status-bar">
    {% if is_spectator %}
        <span>You are <span class="you">spectating</span> ({{ seats_taken }}/2 seats filled).</span>
    {% else %}
        <span>You are <span class="you">{{ my_name or ("Player " ~ my_seat) }}</span> (Player {{ my_seat }}).</span>
    {% endif %}
    {% if game_over %}
        <span>
            Game finished ({{ p1_score }} - {{ p2_score }}).
            <button type="button" class="small" onclick="openGameOverModal()">View result</button>
        </span>
    {% elif not both_seated %}
        <span>Waiting for another player to join before the game can start.</span>
    {% elif your_turn %}
        <strong>Your move.</strong>
    {% elif is_spectator %}
        {% set mover_name = p1_name if game.is_p1_turn else p2_name %}
        <span>{{ mover_name or ("Player " ~ (1 if game.is_p1_turn else 2)) }} to move.</span>
    {% else %}
        <span>Waiting for the other player to move...</span>
    {% endif %}
</div>

<div class="game-container">
    {{ macros.draw_board(game.board, game.moves, marker_pos=game.marker, legal_moves=legal_moves if your_turn else None) }}
    <div class="hands">
        <div class="hand-slot" id="hand-slot-1">
            <div class="seat-header">
                <span class="hand-label">
                    {{ p1_name or "Player 1" }}{% if both_seated and not game_over and game.is_p1_turn %}<span class="turnmarker"></span>{% endif %}
                </span>
                {% if my_seat == 1 and not seats_locked %}
                    <button type="button" class="small" onclick="leaveSeat()">Leave seat</button>
                {% elif is_spectator and not p1_seated and not seats_locked %}
                    <button type="button" class="small" onclick="claimSeat(1)">Join as Player 1</button>
                {% endif %}
            </div>
            {{ macros.draw_hand(game.p1, highlight_card=taken_card) }}
        </div>
        <div class="hand-slot" id="hand-slot-2">
            <div class="seat-header">
                <span class="hand-label">
                    {{ p2_name or "Player 2" }}{% if both_seated and not game_over and game.is_p2_turn %}<span class="turnmarker"></span>{% endif %}
                </span>
                {% if my_seat == 2 and not seats_locked %}
                    <button type="button" class="small" onclick="leaveSeat()">Leave seat</button>
                {% elif is_spectator and not p2_seated and not seats_locked %}
                    <button type="button" class="small" onclick="claimSeat(2)">Join as Player 2</button>
                {% endif %}
            </div>
            {{ macros.draw_hand(game.p2, highlight_card=taken_card) }}
        </div>
    </div>
</div>

{% if game_over %}
<div class="history-stepper">
    <button type="button" onclick="historyGoto(0)" {% if history_index == 0 %}disabled{% endif %}>|&lt; Start</button>
    <button type="button" onclick="historyStep(-1)" {% if history_index == 0 %}disabled{% endif %}>&lt; Prev</button>
    <span>Move {{ history_index }} / {{ history_total }}</span>
    <button type="button" onclick="historyStep(1)" {% if history_index == history_total %}disabled{% endif %}>Next &gt;</button>
    <button type="button" onclick="historyGoto(history_total)" {% if history_index == history_total %}disabled{% endif %}>End &gt;|</button>
</div>
{% if viewing_history %}
<p><em>Viewing move {{ history_index }} of {{ history_total }} - not the final position.</em></p>
{% endif %}

<div class="rematch-controls">
    {{ rematch_controls() }}
</div>
{% endif %}

<div class="mobile-hand-tabs">
    <button type="button" onclick="toggleDrawer(1)">{{ p1_name or "Player 1" }}'s hand</button>
    <button type="button" onclick="toggleDrawer(2)">{{ p2_name or "Player 2" }}'s hand</button>
</div>

{% if game_over %}
<div id="game-over-modal" class="modal-backdrop{% if show_game_over_modal %} open{% endif %}">
    <div class="modal">
        <button type="button" class="modal-close" onclick="closeGameOverModal()" aria-label="Close">&times;</button>
        {% if winner == 0 %}
            <h2>It's a draw!</h2>
        {% elif is_spectator %}
            <h2>{{ (p1_name if winner == 1 else p2_name) or ("Player " ~ winner) }} won!</h2>
        {% elif winner == my_seat %}
            <h2>You won! &#127942;</h2>
        {% else %}
            <h2>You lost.</h2>
        {% endif %}
        <p class="modal-score">{{ p1_name or "Player 1" }} {{ p1_score }} &ndash; {{ p2_score }} {{ p2_name or "Player 2" }}</p>
        <div class="modal-actions">
            {{ rematch_controls() }}
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeGameOverModal()">Close</button>
        </div>
    </div>
</div>
{% endif %}
