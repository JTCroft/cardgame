{% import "components.html.jinja2" as macros %}

{% macro rematch_controls() %}
    {% if vs_computer and not is_spectator %}
        <button type="button" onclick="requestRematch()">New game</button>
    {% elif vs_computer %}
        {# Spectating someone else's solo game - only the owner can start a new one. #}
    {% elif is_spectator %}
        {% if rematch_pending %}
            <p>Waiting for the players to decide on a rematch...</p>
        {% endif %}
    {% elif rematch_pending %}
        {% if rematch_requested_by_me %}
            <p>Waiting for {{ ((p2_name if my_seat == 1 else p1_name)) or "the other player" }} to respond...</p>
        {% else %}
            <p>{{ rematch_requested_by_name or "The other player" }} wants a rematch!</p>
            <button type="button" onclick="respondRematch(true)">Accept</button>
            <button type="button" onclick="respondRematch(false)">Decline</button>
        {% endif %}
    {% else %}
        <button type="button" onclick="requestRematch()">Request rematch</button>
    {% endif %}
{% endmacro %}

{% if is_spectator and not review %}
<div class="role-badge">Spectating ({{ seats_taken }}/2 seated)</div>
{% endif %}

{# Whether the *currently displayed* position is terminal - not the same as
   game_over, which is true for the room as a whole even while scrubbing
   back through history to a non-final move (e.g. reviewing a finished
   game, or stepping through one that just ended). Using game.legal_moves
   directly means the trophy only shows at the actual final position, and
   the turn indicator is restored at every earlier one. #}
{% set position_over = not game.legal_moves %}

<div class="game-container">
    {{ macros.draw_board(game.board, game.moves, marker_pos=game.marker, legal_moves=legal_moves if your_turn else None) }}
    <div class="hands">
        <div class="hand-slot" id="hand-slot-1">
            <div class="seat-header">
                <span class="hand-label">
                    {{ p1_name or "Player 1" }}{% if both_seated and not position_over and game.is_p1_turn %}<span class="turnmarker"></span>{% elif position_over and winner == 1 %}<span class="trophy">&#127942;</span>{% endif %}
                </span>
                {% if my_seat == 1 %}
                    {% if not seats_locked and not vs_computer %}
                        <button type="button" class="small" onclick="leaveSeat()">Leave seat</button>
                    {% endif %}
                {% elif p1_seated and p1_disconnected and not vs_computer %}
                    <button type="button" class="small" onclick="kickSeat(1)">Kick</button>
                {% elif p1_seated and my_seat == 2 and not game_started %}
                    <button type="button" class="small" onclick="swapSeats()">Swap seats</button>
                {% elif is_spectator and not p1_seated %}
                    <button type="button" class="small" onclick="claimSeat(1)">Join as Player 1</button>
                {% endif %}
            </div>
            {{ macros.draw_hand(game.p1, highlight_card=taken_card) }}
        </div>
        <div class="hand-slot" id="hand-slot-2">
            <div class="seat-header">
                <span class="hand-label">
                    {{ p2_name or "Player 2" }}{% if both_seated and not position_over and game.is_p2_turn %}<span class="turnmarker"></span>{% elif position_over and winner == 2 %}<span class="trophy">&#127942;</span>{% endif %}
                </span>
                {% if my_seat == 2 %}
                    {% if not seats_locked and not vs_computer %}
                        <button type="button" class="small" onclick="leaveSeat()">Leave seat</button>
                    {% endif %}
                {% elif p2_seated and p2_disconnected and not vs_computer %}
                    <button type="button" class="small" onclick="kickSeat(2)">Kick</button>
                {% elif p2_seated and my_seat == 1 and not game_started %}
                    <button type="button" class="small" onclick="swapSeats()">Swap seats</button>
                {% elif is_spectator and not p2_seated %}
                    <button type="button" class="small" onclick="claimSeat(2)">Join as Player 2</button>
                {% endif %}
            </div>
            {{ macros.draw_hand(game.p2, highlight_card=taken_card) }}
        </div>
        {% if game_over %}
        {# Desktop only - underneath player 2's hand, where it sits in the
           .hands column. Mobile gets its own copy below the history
           stepper instead, since .hands collapses to a fixed drawer there
           and this position wouldn't make sense. #}
        <div class="rematch-controls rematch-controls-desktop">
            {{ rematch_controls() }}
        </div>
        {% endif %}
    </div>
</div>

{% if game_over %}
<div class="history-stepper">
    <button type="button" onclick="historyGoto(0)" {% if history_index == 0 %}disabled{% endif %} aria-label="Go to start">|&lt;</button>
    <button type="button" onclick="historyStep(-1)" {% if history_index == 0 %}disabled{% endif %} aria-label="Previous move">&lt;</button>
    <span class="history-count">{{ history_index }} / {{ history_total }}</span>
    <button type="button" onclick="historyStep(1)" {% if history_index == history_total %}disabled{% endif %} aria-label="Next move">&gt;</button>
    <button type="button" onclick="historyGoto({{ history_total }})" {% if history_index == history_total %}disabled{% endif %} aria-label="Go to end">&gt;|</button>
</div>

{% if move_analysis %}
<div class="move-analysis">
    {% if move_analysis.calculable %}
        <h3>Move comparison <span class="analysis-sub">{{ move_analysis.mover_name }} to move</span></h3>
        <p class="analysis-note">This position was too deep for the automatic post-game analysis to reach.</p>
        <button type="button" onclick="calculateMove({{ move_analysis.history_index }})">Calculate</button>
    {% elif move_analysis.pending %}
        <p class="analysis-note">
            Move comparison for this position is still being computed{% if move_analysis.started_ago is not none %} (<span class="analysis-timer" data-started-ago="{{ move_analysis.started_ago }}">{{ "%.0f"|format(move_analysis.started_ago) }}s</span> so far){% endif %}&hellip;
        </p>
    {% else %}
        {% macro analysis_card(row) %}
            {%- if row.card.facedown -%}
                Face-down (row {{ row.marker[0] + 1 }}, col {{ row.marker[1] + 1 }}){% if row.revealed %} &rarr; <span class="cardtext{% if row.revealed.suit_name in ("hearts", "diamonds") %} red{% endif %}">{{ row.revealed }}</span>{% endif %}
            {%- else -%}
                <span class="cardtext{% if row.card.suit_name in ("hearts", "diamonds") %} red{% endif %}">{{ row.card }}</span>
            {%- endif -%}
        {% endmacro %}
        <h3>Move comparison <span class="analysis-sub">{{ move_analysis.mover_name }} to move</span></h3>
        {% if move_analysis.streaming %}
        <p class="analysis-note">
            Solving each move&hellip; ({{ move_analysis.done_count }}/{{ move_analysis.total_count }} done)
        </p>
        {% elif move_analysis.generating_heatmap %}
        <p class="analysis-note">
            Generating heatmap&hellip;
        </p>
        {% elif move_analysis.incomplete %}
        <p class="analysis-note">
            Analysis stopped before finishing &mdash; {{ move_analysis.done_count }} of {{ move_analysis.total_count }} moves solved.
        </p>
        {% endif %}
        {% if move_analysis.heatmap %}
        <div class="outcome-heatmap">
            {% set columns = "repeat(" ~ move_analysis.heatmap.cells|length ~ ", 1fr)" %}
            <div class="outcome-heatmap-row" style="grid-template-columns: {{ columns }};">
                {% for cell in move_analysis.heatmap.cells %}
                <div class="outcome-heatmap-cell{% if cell.zero %} outcome-heatmap-cell-zero{% endif %}"
                     style="background-color: {{ cell.color }}; color: {{ cell.text_color }};"
                     title="{{ cell.label }} pts: {{ "%.0f"|format(cell.pct) }}% of outcomes">{{ "%.0f"|format(cell.pct) }}%</div>
                {% endfor %}
            </div>
            <div class="outcome-heatmap-ticks" style="grid-template-columns: {{ columns }};">
                {% for cell in move_analysis.heatmap.cells %}
                <span class="outcome-heatmap-tick">{% if cell.zero %}Draw{% else %}{{ cell.label }}{% endif %}</span>
                {% endfor %}
            </div>
            <div class="outcome-heatmap-names">
                <span>{{ p2_name or "Player 2" }}</span>
                <span>{{ p1_name or "Player 1" }}</span>
            </div>
        </div>
        {% endif %}
        <div class="analysis-table-wrap">
            <table class="analysis-table">
                <thead>
                    <tr>
                        <th>Take</th>
                        <th title="Share of face-down orderings where {{ move_analysis.p1_name }} wins under optimal play from here">{{ move_analysis.p1_name }}<br>win%</th>
                        <th title="Share of face-down orderings where {{ move_analysis.p2_name }} wins under optimal play from here">{{ move_analysis.p2_name }}<br>win%</th>
                        <th title="Share of face-down orderings that end in a draw under optimal play from here">Draw%</th>
                        <th title="Swing in ({{ move_analysis.mover_name }} - {{ move_analysis.opponent_name }}) vs the best move">Swing</th>
                        <th title="Change in {{ move_analysis.p1_name }}'s average points vs the best move">{{ move_analysis.p1_name }}</th>
                        <th title="Change in {{ move_analysis.p2_name }}'s average points vs the best move">{{ move_analysis.p2_name }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in move_analysis.rows %}
                    <tr class="{% if row.played %}analysis-played{% endif %}{% if row.status %} analysis-unsolved{% endif %}">
                        <td>{{ analysis_card(row) }}</td>
                        {% if row.status %}
                        <td class="num">&mdash;</td>
                        <td class="num">&mdash;</td>
                        <td class="num">&mdash;</td>
                        <td class="num">&mdash;</td>
                        <td class="num">&mdash;</td>
                        <td class="num">&mdash;</td>
                        <td class="badges">
                            {%- if row.status == "calculating" -%}
                                <span class="badge badge-calculating">calculating&hellip;</span>
                            {%- else -%}
                                <span class="badge badge-stopped">stopped</span>
                            {%- endif -%}
                            {%- if row.played %}<span class="badge badge-played">played</span>{% endif -%}
                        </td>
                        {% else %}
                        <td class="num">{{ "%.0f"|format(row.p1_win_pct) }}%</td>
                        <td class="num">{{ "%.0f"|format(row.p2_win_pct) }}%</td>
                        <td class="num">{{ "%.0f"|format(row.draw_pct) }}%</td>
                        <td class="num">{{ "%+.2f"|format(row.combined) }}</td>
                        <td class="num">{{ "%+.2f"|format(row.p1_change) }}</td>
                        <td class="num">{{ "%+.2f"|format(row.p2_change) }}</td>
                        <td class="badges">
                            {%- if row.best %}<span class="badge badge-best">best</span>{% endif -%}
                            {%- if row.played %}<span class="badge badge-played">played</span>{% endif -%}
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endif %}

<div class="rematch-controls rematch-controls-mobile">
    {{ rematch_controls() }}
</div>
{% endif %}

<div class="mobile-hand-tabs">
    <button type="button" id="hand-tab-1" onclick="selectHand(1)">
        <span class="turn-slot">{% if both_seated and not position_over and game.is_p1_turn %}<span class="turnmarker"></span>{% elif position_over and winner == 1 %}<span class="trophy">&#127942;</span>{% endif %}</span>{{ p1_name or "Player 1" }} ({{ game.p1.score() }})
    </button>
    <button type="button" id="hand-tab-2" onclick="selectHand(2)">
        <span class="turn-slot">{% if both_seated and not position_over and game.is_p2_turn %}<span class="turnmarker"></span>{% elif position_over and winner == 2 %}<span class="trophy">&#127942;</span>{% endif %}</span>{{ p2_name or "Player 2" }} ({{ game.p2.score() }})
    </button>
</div>

{% if game_over %}
<div id="game-over-modal" class="modal-backdrop{% if show_game_over_modal %} open{% endif %}">
    <div class="modal">
        <button type="button" class="modal-close" onclick="closeGameOverModal()" aria-label="Close">&times;</button>
        {% if winner == 0 %}
            <h2>It's a draw!</h2>
        {% elif is_spectator %}
            <h2>{{ (p1_name if winner == 1 else p2_name) or ("Player " ~ winner) }} won!</h2>
        {% elif winner == my_seat %}
            <h2>You won! &#127942;</h2>
        {% else %}
            <h2>You lost.</h2>
        {% endif %}
        <p class="modal-score">{{ p1_name or "Player 1" }} {{ p1_score }} &ndash; {{ p2_score }} {{ p2_name or "Player 2" }}</p>
        <div class="modal-actions">
            {{ rematch_controls() }}
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeGameOverModal()">Close</button>
        </div>
    </div>
</div>
{% endif %}
